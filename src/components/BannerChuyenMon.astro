---
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<!-- Cong canh bao chuyen mon - bat buoc theo Muc 3.3, khong duoc bo -->
<aside
  class="rounded-2xl border border-hophach/30 bg-hophach-nhat px-4 py-3 text-sm leading-relaxed text-[#6d4a12]"
  role="note"
>
  <span class="mr-2 inline-flex h-5 w-5 shrink-0 -translate-y-px items-center justify-center rounded-full bg-hophach text-[11px] font-bold text-white" aria-hidden="true">!</span>
  {t('banner.chuyen_mon')}
</aside>
