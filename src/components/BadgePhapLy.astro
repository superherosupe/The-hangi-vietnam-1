---
import { useT, type Lang } from '../i18n';

interface Props {
  phanLoai: string;
  lang: Lang;
  /** nen trang - dung khi dat badge de len anh san pham */
  nenTrang?: boolean;
}
const { phanLoai, lang, nenTrang = false } = Astro.props;
const t = useT(lang);
const laTBYT = phanLoai.startsWith('thiet-bi-y-te');
const label = t(`badge.${phanLoai}` as Parameters<typeof t>[0]);
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-semibold',
    nenTrang
      ? ['bg-white shadow-sm', laTBYT ? 'text-[#8a5a10]' : 'text-duoc-dam']
      : laTBYT
        ? 'bg-hophach-nhat text-[#8a5a10]'
        : 'bg-bacha text-duoc-dam',
  ]}
>
  <span class:list={['h-1.5 w-1.5 rounded-full', laTBYT ? 'bg-hophach' : 'bg-ngoclam']} aria-hidden="true"></span>
  {label}
</span>
