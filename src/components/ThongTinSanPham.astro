---
import type { CollectionEntry } from 'astro:content';
import { useT, type Lang } from '../i18n';

interface Props {
  sp: CollectionEntry<'products'>;
  lang: Lang;
}
const { sp, lang } = Astro.props;
const t = useT(lang);
const d = sp.data;
const coNoiDung = d.khau_hieu || d.thanh_phan_chinh.length > 0 || d.cong_nghe.length > 0;

// Luoi day du la 2 cot (mobile) / 3 cot (sm+) cho thanh_phan_chinh, va 3 cot (md+)
// cho cong_nghe. Khi so muc it hon so cot, giam so cot xuong dung bang so muc va
// gioi han be rong khung theo ti le cot goc roi mx-auto, de khung nam gon giua
// thay vi de trong mot khoang lon.
const khungThanhPhan = (() => {
  const n = d.thanh_phan_chinh.length;
  if (n === 1) return 'grid-cols-1 max-w-[50%] sm:max-w-[33.333%] mx-auto';
  if (n === 2) return 'grid-cols-2 sm:max-w-[66.667%] mx-auto';
  return 'grid-cols-2 sm:grid-cols-3';
})();
const khungCongNghe = (() => {
  const n = d.cong_nghe.length;
  if (n === 2) return 'md:grid-cols-2 md:max-w-[66.667%] md:mx-auto';
  return 'md:grid-cols-3';
})();
// Chi 1 cong nghe: khong danh so, trinh bay ngang het chieu rong thay vi the doc hep.
const congNgheMotMuc = d.cong_nghe.length === 1;
---

{
  coNoiDung && (
    <section class="mt-6" aria-labelledby="thong-tin-sp">
      <div class="rounded-3xl bg-bacha/60 px-5 py-10 sm:px-10">
        <p class="text-center font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-ngoclam">
          {t('sp.thong_tin_san_pham')}
        </p>
        {d.khau_hieu && (
          <h2 id="thong-tin-sp" class="mx-auto mt-2 max-w-2xl text-center text-2xl font-bold tracking-tight text-muc sm:text-3xl">
            {d.khau_hieu}
          </h2>
        )}

        {d.thanh_phan_chinh.length > 0 && (
          <div class="mt-10">
            <h3 class="text-center text-sm font-bold uppercase tracking-[0.14em] text-duoc-dam">
              {t('sp.thanh_phan_chinh')}
            </h3>
            <ul class={`mt-5 grid gap-3 ${khungThanhPhan}`}>
              {d.thanh_phan_chinh.map((tp) => (
                <li class="relative flex min-h-[104px] flex-col items-center justify-center overflow-hidden rounded-2xl bg-white px-3 py-5 text-center shadow-sm ring-1 ring-bacha transition-shadow hover:shadow-[0_8px_24px_rgba(14,116,144,0.14)]">
                  <span class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-duoc to-ngoclam" aria-hidden="true" />
                  <span class="text-[15px] font-bold leading-tight text-muc">{tp.ten}</span>
                  {tp.mo_ta && <span class="mt-1.5 text-[11px] leading-snug text-muc/55">{tp.mo_ta}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {d.cong_nghe.length > 0 && (
          <div class="mt-12">
            <h3 class="text-center text-sm font-bold uppercase tracking-[0.14em] text-duoc-dam">
              {t('sp.cong_nghe_loi')}
            </h3>
            {congNgheMotMuc ? (
              <div class="mt-5 flex flex-col gap-3 rounded-2xl bg-gradient-to-br from-duoc-dam via-duoc to-ngoclam p-6 text-white shadow-[0_10px_30px_rgba(14,116,144,0.25)] sm:flex-row sm:items-center sm:gap-6 sm:p-7">
                <h4 class="shrink-0 text-center text-base font-bold leading-snug sm:w-64">{d.cong_nghe[0].ten}</h4>
                <p class="text-justify text-sm leading-relaxed text-white/85">{d.cong_nghe[0].mo_ta}</p>
              </div>
            ) : (
              <div class={`mt-5 grid gap-4 ${khungCongNghe}`}>
                {d.cong_nghe.map((cn, i) => (
                  <article class="flex flex-col rounded-2xl bg-gradient-to-br from-duoc-dam via-duoc to-ngoclam p-6 text-white shadow-[0_10px_30px_rgba(14,116,144,0.25)]">
                    <span
                      class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-white/15 font-mono text-[11px] font-medium text-white ring-1 ring-white/30"
                      aria-hidden="true"
                    >
                      0{i + 1}
                    </span>
                    <h4 class="mt-3 text-base font-bold leading-snug">{cn.ten}</h4>
                    <p class="mt-2 text-justify text-sm leading-relaxed text-white/85">{cn.mo_ta}</p>
                  </article>
                ))}
              </div>
            )}
          </div>
        )}

        <p class="mt-9 border-t border-muc/10 pt-4 text-center text-[11px] leading-relaxed text-muc/45">
          {`${t('sp.theo_nsx_truoc')} ${d.chu_so_huu_ten}, ${t('sp.theo_nsx_sau')}`}
        </p>
      </div>
    </section>
  )
}
