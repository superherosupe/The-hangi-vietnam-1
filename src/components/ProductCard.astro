---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BadgePhapLy from './BadgePhapLy.astro';
import { useT, localePath, type Lang } from '../i18n';

interface Props {
  sp: CollectionEntry<'products'>;
  lang: Lang;
  eager?: boolean;
}
const { sp, lang, eager = false } = Astro.props;
const t = useT(lang);
const slug = sp.id.split('/').pop()!;
const href = localePath(lang, `/san-pham/${slug}`);
---

<!-- Card san pham: anh, ten, thuong hieu, badge phap ly. KHONG hien cong dung (Muc 6.2) -->
<article
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-bacha/80 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-duoc/30 hover:shadow-[0_12px_40px_rgba(14,116,144,0.13)]"
  data-nhom={sp.data.nhom}
  data-phan-loai={sp.data.phan_loai_phap_ly}
  data-thuong-hieu={sp.data.thuong_hieu.toLowerCase()}
  data-search={`${sp.data.ten} ${sp.data.ma_san_pham}`.toLowerCase()}
>
  <div class="relative aspect-square overflow-hidden bg-gradient-to-br from-bacha/50 to-white p-5">
    <Image
      src={sp.data.anh}
      alt={sp.data.anh_alt}
      width={640}
      height={640}
      loading={eager ? 'eager' : 'lazy'}
      class="h-full w-full rounded-lg object-contain transition-transform duration-500 group-hover:scale-[1.04]"
    />
    <span class="absolute left-3 top-3">
      <BadgePhapLy phanLoai={sp.data.phan_loai_phap_ly} lang={lang} nenTrang />
    </span>
  </div>
  <div class="flex flex-1 flex-col p-5 pt-4">
    <p class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-ngoclam">{sp.data.thuong_hieu}</p>
    <h3 class="mt-1.5 text-lg font-bold leading-tight text-muc">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] group-hover:text-duoc">
        {sp.data.ten}
      </a>
    </h3>
    <p class="mb-4 mt-1.5 text-[13px] leading-relaxed text-muc/55">{sp.data.quy_cach}</p>
    <div class="mt-auto border-t border-bacha/70 pt-3">
      <p class="text-[11px] text-muc/40">{t('danhmuc.so_cong_bo')}</p>
      <p class="mt-0.5 font-mono text-[11px] text-muc/70">{sp.data.so_luu_hanh_hoac_cong_bo}</p>
    </div>
  </div>
</article>
