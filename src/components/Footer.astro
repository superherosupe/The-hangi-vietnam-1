---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon.png';
import { SITE } from '../data/site';
import { useT, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const p = (href: string) => localePath(lang, href);
const namHienTai = new Date().getFullYear();
---

<footer class="border-t border-bacha bg-muc text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="flex items-center gap-2.5">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white p-1">
          <Image src={logoIcon} alt="" width={56} height={59} class="h-7 w-auto" aria-hidden="true" />
        </span>
        <span class="text-base font-bold tracking-tight">THE HANGI</span>
      </p>
      <p class="mt-2 text-sm font-semibold text-bacha">
        {lang === 'vi' ? SITE.ten_day_du : SITE.ten_day_du_en}
      </p>
      <dl class="mt-4 space-y-2 text-sm text-white/80">
        <div class="flex gap-2">
          <dt class="shrink-0 font-medium text-white/60">{t('footer.mst')}:</dt>
          <dd>{SITE.ma_so_thue}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0 font-medium text-white/60">{t('footer.tru_so')}:</dt>
          <dd>{lang === 'vi' ? SITE.tru_so : SITE.tru_so_en}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0 font-medium text-white/60">{t('footer.vp')}:</dt>
          <dd>{lang === 'vi' ? SITE.van_phong : SITE.van_phong_en}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0 font-medium text-white/60">{t('footer.nguoi_chiu_trach_nhiem')}:</dt>
          <dd>{SITE.nguoi_chiu_trach_nhiem_noi_dung}</dd>
        </div>
      </dl>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-white/60">{t('nav.lien_he')}</p>
      <ul class="mt-4 space-y-2 text-sm text-white/80">
        <!-- CHUA CO hotline va email - dien vao src/data/site.ts khi co -->
        <li>
          <span class="font-medium text-white/60">{t('footer.hotline')}:</span>
          {SITE.hotline || t('footer.dang_cap_nhat')}
        </li>
        <li>
          <span class="font-medium text-white/60">{t('footer.email')}:</span>
          {SITE.email || t('footer.dang_cap_nhat')}
        </li>
        <li class="pt-2 text-white/60">{SITE.pham_vi}</li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-white/60">
        {lang === 'vi' ? 'Liên kết' : 'https://www.facebook.com/profile.php?id=61591032317104'}
      </p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="text-white/80 hover:text-white hover:underline" href={p('/san-pham')}>{t('nav.san_pham')}</a></li>
        <li><a class="text-white/80 hover:text-white hover:underline" href={p('/tai-lieu')}>{t('nav.tai_lieu')}</a></li>
        <li><a class="text-white/80 hover:text-white hover:underline" href={p('/doi-tac')}>{t('nav.doi_tac')}</a></li>
        <li>
          <a class="text-white/80 hover:text-white hover:underline" href={p('/chinh-sach-bao-mat')}>{t('footer.chinh_sach')}</a>
        </li>
        <li><a class="text-white/80 hover:text-white hover:underline" href={p('/dieu-khoan')}>{t('footer.dieu_khoan')}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-white/50 sm:px-6">
      {namHienTai} - {t('footer.ban_quyen')}
    </p>
  </div>
</footer>
