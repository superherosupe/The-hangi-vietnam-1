---
import TrangDangHoanThien from '../layouts/TrangDangHoanThien.astro';
import { SITE, telHref } from '../data/site';
---

<TrangDangHoanThien
  title="Liên hệ | The Hangi Việt Nam"
  description="Liên hệ The Hangi Việt Nam để nhận báo giá, tài liệu chuyên môn hoặc trao đổi hợp tác phân phối."
  heading="Liên hệ"
  path="/lien-he"
>
  <div class="mt-4 max-w-2xl space-y-3 text-sm leading-relaxed text-muc/80">
    <p><strong>{SITE.ten_day_du}</strong></p>
    <p>Trụ sở: {SITE.tru_so}</p>
    <p>Văn phòng: {SITE.van_phong}</p>
    <p>
      Hotline:{' '}
      {SITE.hotline.map((so, i) => (
        <>
          {i > 0 && ' / '}
          <a href={telHref(so)} class="text-duoc hover:underline">
            {so}
          </a>
        </>
      ))}
    </p>
    <p>Email: <a href={`mailto:${SITE.email}`} class="text-duoc hover:underline">{SITE.email}</a></p>
    <!-- Form lien he se duoc dung o buoc 6 -->
    <p class="text-muc/50">Form liên hệ trực tuyến sẽ sớm có mặt tại đây.</p>
  </div>
</TrangDangHoanThien>
