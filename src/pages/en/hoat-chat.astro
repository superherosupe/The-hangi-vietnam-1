---
import Base from '../../layouts/Base.astro';
import BannerChuyenMon from '../../components/BannerChuyenMon.astro';
import { useT } from '../../i18n';
import { baiVietEn } from '../../data/hoat-chat';

const lang = 'en' as const;
const t = useT(lang);
---

<Base
  title="Science | The Hangi Vietnam"
  description="Articles on ingredients and technologies behind the aesthetic-dermatology products distributed by The Hangi."
  lang={lang}
  path="/hoat-chat"
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <BannerChuyenMon lang={lang} />
    <h1 class="mt-8 text-3xl font-bold tracking-tight text-muc">{t('hoatchatpage.tieude')}</h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muc/70">{t('hoatchatpage.mota')}</p>

    <div class="mt-12 space-y-16">
      {
        baiVietEn.map((bai) => (
          <article id={bai.id} class="scroll-mt-24">
            <h2 class="text-2xl font-bold tracking-tight text-muc">{bai.tieuDe}</h2>
            <div class="mt-4 space-y-4 text-sm leading-relaxed text-muc/80">
              {bai.doanMoDau.map((doan) => (
                <p>{doan}</p>
              ))}
            </div>
            <div class="mt-8 space-y-8">
              {bai.muc.map((m) => (
                <div>
                  <h3 class="text-sm font-bold uppercase tracking-wider text-duoc-dam">{m.tieuDe}</h3>
                  <div class="mt-3 space-y-3 text-sm leading-relaxed text-muc/80">
                    {m.doanVan.map((doan) => (
                      <p>{doan}</p>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-8 rounded-2xl border border-hophach/30 bg-hophach-nhat p-4">
              <p class="text-xs font-bold uppercase tracking-wider text-[#8a5a10]">{t('hoatchatpage.luu_y')}</p>
              <p class="mt-1.5 text-[13px] leading-relaxed text-[#6d4a12]">{bai.luuY}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Base>
