---
import TrangDangHoanThien from '../../layouts/TrangDangHoanThien.astro';
import FormLienHe from '../../components/FormLienHe.astro';
import { SITE, telHref } from '../../data/site';

const lang = 'en' as const;
---

<TrangDangHoanThien
  title="Contact | The Hangi Vietnam"
  description="Contact The Hangi Vietnam for quotations, professional documentation or distribution partnership."
  heading="Contact"
  lang={lang}
  path="/lien-he"
>
  <div class="mt-4 max-w-2xl space-y-3 text-sm leading-relaxed text-muc/80">
    <p><strong>{SITE.ten_day_du_en}</strong></p>
    <p>Head office: {SITE.tru_so_en}</p>
    <p>Business registration address: {SITE.dia_chi_dkkd_en}</p>
    <p>
      Hotline:{' '}
      {SITE.hotline.map((so, i) => (
        <>
          {i > 0 && ' / '}
          <a href={telHref(so)} class="text-duoc hover:underline">
            {so}
          </a>
        </>
      ))}
    </p>
    <p>Email: <a href={`mailto:${SITE.email}`} class="text-duoc hover:underline">{SITE.email}</a></p>
  </div>
  <FormLienHe lang={lang} />
</TrangDangHoanThien>
