---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { useT, localePath } from '../../i18n';
import { baiVietEn } from '../../data/hoat-chat';
import anhHero0 from '../../assets/products/pllacube-hero-1.jpg';
import anhHero1 from '../../assets/products/pllacube-hero-2.jpg';
import anhHero2 from '../../assets/products/skinphilia-hero.jpg';

const lang = 'en' as const;
const t = useT(lang);
const p = (href: string) => localePath(lang, href);

// San pham chua co ban en se bi an khoi danh muc tieng Anh (Muc 8)
const sanPham = (await getCollection('products', (sp) => sp.id.startsWith('en/'))).sort(
  (a, b) => a.data.thu_tu - b.data.thu_tu
);
---

<Base title="The Hangi Vietnam - Authorized aesthetic and dermatology distribution" description={t('site.mota')} lang={lang} path="/">
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] bg-gradient-to-b from-bacha via-white to-white" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-[1520px] items-center gap-10 px-4 pb-16 pt-12 sm:px-6 md:grid-cols-[1.1fr_0.9fr] md:pt-16">
      <div>
        <p class="len-nhe inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-xs font-semibold text-duoc shadow-sm ring-1 ring-bacha">
          <span class="h-1.5 w-1.5 rounded-full bg-ngoclam" aria-hidden="true"></span>
          {t('hero.tagline')}
        </p>
        <h1 class="len-nhe len-nhe-2 mt-5 max-w-xl text-4xl font-bold leading-[1.15] tracking-tight text-muc sm:text-5xl xl:text-6xl">
          Science-based skincare, starting from <span class="text-duoc">a transparent origin</span>.
        </h1>
        <p class="len-nhe len-nhe-3 mt-5 max-w-lg text-base leading-relaxed text-muc/70">{t('hero.sub')}</p>
        <div class="len-nhe len-nhe-4 mt-8 flex flex-wrap gap-3">
          <a href={p('/san-pham')} class="rounded-full bg-duoc px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-duoc-dam">
            {t('hero.cta_sanpham')}
          </a>
          <a
            href={p('/doi-tac')}
            class="rounded-full border border-duoc/25 bg-white px-6 py-3 text-sm font-semibold text-duoc transition-colors hover:border-duoc hover:bg-bacha"
          >
            {t('hero.cta_doitac')}
          </a>
        </div>
      </div>
      <div class="hero-carousel-wrap">
        <div class="overflow-hidden rounded-3xl shadow-[0_20px_60px_rgba(14,116,144,0.18)]">
          <div class="hero-carousel" id="heroCarousel">
            <Image src={anhHero0} alt={t('hero.anh_alt')} width={880} loading="eager" fetchpriority="high" class="carousel-img active" data-index="0" />
            <Image src={anhHero1} alt="PLLACUBE PiNk VOL. — PLLA+PN skinbooster with HA and Peptide" width={880} loading="lazy" class="carousel-img" data-index="1" />
            <Image src={anhHero2} alt="SKINPHILIA EXOMUNE BOOSTER &amp; MASK — Umbilical cord blood stem cell exosome from South Korea" width={880} loading="lazy" class="carousel-img" data-index="2" />
          </div>
        </div>
        <button class="carousel-arrow carousel-prev" aria-label="Previous" id="carouselPrev">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="carousel-arrow carousel-next" aria-label="Next" id="carouselNext">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </section>

  <style is:global>
    .hero-carousel-wrap { position: relative; }
    .hero-carousel { position: relative; width: 100%; aspect-ratio: 1 / 1; }
    .carousel-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s ease-in-out; pointer-events: none; }
    .carousel-img.active { opacity: 1; pointer-events: auto; }
    .carousel-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.85); backdrop-filter: blur(4px); border: 1px solid rgba(14,116,144,0.15); color: #0E7490; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; z-index: 10; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .carousel-arrow:hover { background: #0E7490; color: #fff; border-color: #0E7490; box-shadow: 0 4px 16px rgba(14,116,144,0.3); }
    .carousel-prev { left: 12px; }
    .carousel-next { right: 12px; }
  </style>

  <script>
    (function() {
      const carousel = document.getElementById('heroCarousel');
      if (!carousel) return;
      const imgs = carousel.querySelectorAll('.carousel-img');
      const prevBtn = document.getElementById('carouselPrev');
      const nextBtn = document.getElementById('carouselNext');
      let current = 0;
      const total = imgs.length;
      let timer;

      function show(idx) {
        imgs.forEach((img, i) => img.classList.toggle('active', i === idx));
        current = idx;
      }
      function next() { show((current + 1) % total); }
      function prev() { show((current - 1 + total) % total); }
      function startTimer() { clearInterval(timer); timer = setInterval(next, 5000); }

      nextBtn?.addEventListener('click', () => { next(); startTimer(); });
      prevBtn?.addEventListener('click', () => { prev(); startTimer(); });

      let touchStartX = 0;
      carousel.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; });
      carousel.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) { diff > 0 ? next() : prev(); startTimer(); }
      });

      startTimer();
    })();
  </script>

  <!-- DANH MUC SAN PHAM -->
  <section class="bg-bacha/60 py-16">
    <div class="mx-auto max-w-[1520px] px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-muc sm:text-3xl xl:text-4xl">{t('danhmuc.tieude')}</h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-muc/70">{t('danhmuc.mota')}</p>
        </div>
        <a href={p('/san-pham')} class="text-sm font-semibold text-duoc hover:text-duoc-dam hover:underline">
          {t('danhmuc.xem_tat_ca')} &rarr;
        </a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {sanPham.map((sp) => (
          <ProductCard sp={sp} lang={lang} />
        ))}
        <div class="flex flex-col items-start justify-center rounded-2xl border border-dashed border-duoc/25 bg-white/60 p-6">
          <span class="rounded-full bg-bacha px-2.5 py-1 text-[11px] font-semibold text-duoc-dam">{t('danhmuc.sap_ra_mat')}</span>
          <p class="mt-3 text-justify text-sm leading-relaxed text-muc/60">{t('danhmuc.sap_ra_mat_mota')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TAI LIEU THAM KHAO -->
  <section class="py-16">
    <div class="mx-auto max-w-[1520px] px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-muc sm:text-3xl xl:text-4xl">References</h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-muc/70">Professional knowledge, scientific research and reference materials — for healthcare professionals and partners.</p>
        </div>
        <a href={p('/hoat-chat')} class="text-sm font-semibold text-duoc hover:text-duoc-dam hover:underline">
          View all &rarr;
        </a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          baiVietEn.map((bai) => (
            <a href={`${p('/hoat-chat')}/${bai.id}`} class="group flex flex-col rounded-2xl border border-bacha/70 bg-white p-6 transition-all hover:-translate-y-1 hover:border-duoc/20 hover:shadow-[0_12px_40px_rgba(14,116,144,0.13)]">
              <h3 class="mt-4 text-base font-bold leading-snug text-muc group-hover:text-duoc">{bai.tieuDe}</h3>
              <p class="mt-2 flex-1 text-[12.5px] leading-relaxed text-muc/55 line-clamp-4">{bai.doanMoDau[0]}</p>
              <span class="mt-4 text-xs font-semibold text-duoc group-hover:underline">Read more &rarr;</span>
            </a>
          ))
        }
      </div>
      <p class="mt-6 text-xs leading-relaxed text-muc/50">
        This content is general reference knowledge only, not a declaration of efficacy for any specific product.
        Product efficacy is stated solely as recorded in the declaration dossier, shown on each product detail page.
      </p>
    </div>
  </section>

  <!-- VI SAO CHON THE HANGI -->
  <section class="bg-bacha/60 py-16">
    <div class="mx-auto max-w-[1520px] px-4 sm:px-6">
      <h2 class="text-2xl font-bold tracking-tight text-muc sm:text-3xl xl:text-4xl">{t('visao.tieude')}</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          [
            { tieude: t('visao.1.tieude'), mota: t('visao.1.mota'), icon: 'M9 12.75 11.25 15l3.75-4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' },
            { tieude: t('visao.2.tieude'), mota: t('visao.2.mota'), icon: 'M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z' },
            { tieude: t('visao.3.tieude'), mota: t('visao.3.mota'), icon: 'M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25' },
          ].map((mucItem) => (
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-bacha/70 transition-all hover:shadow-md hover:ring-duoc/20">
              <div class="flex justify-center">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-duoc/10 text-duoc" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path d={mucItem.icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
              <h3 class="mt-5 text-center text-base font-bold text-muc">{mucItem.tieude}</h3>
              <p class="mt-2 text-justify text-sm leading-relaxed text-muc/60">{mucItem.mota}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16">
    <div class="mx-auto max-w-[1520px] px-4 sm:px-6">
      <div class="overflow-hidden rounded-3xl bg-gradient-to-br from-duoc-dam to-duoc px-6 py-14 text-center sm:px-12 shadow-xl shadow-duoc/15">
        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">{t('cta.tieude')}</h2>
        <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-white/85">{t('cta.mota')}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={p('/lien-he')} class="rounded-full bg-white px-7 py-3.5 text-[15px] font-semibold text-duoc-dam shadow-sm transition-all hover:bg-bacha hover:shadow-md">
            {t('cta.lien_he')}
          </a>
          <a
            href={p('/doi-tac')}
            class="rounded-full border-2 border-white/30 px-7 py-3.5 text-[15px] font-semibold text-white transition-all hover:border-white hover:bg-white/10"
          >
            {t('cta.doi_tac')}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
