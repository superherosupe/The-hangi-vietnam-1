---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import BadgePhapLy from '../../../components/BadgePhapLy.astro';
import BannerChuyenMon from '../../../components/BannerChuyenMon.astro';
import ChipHoatChat from '../../../components/ChipHoatChat.astro';
import ThongTinSanPham from '../../../components/ThongTinSanPham.astro';
import { SITE, SITE_URL } from '../../../data/site';
import { useT, localePath, BASE } from '../../../i18n';

export async function getStaticPaths() {
  const sanPham = await getCollection('products', (sp) => sp.id.startsWith('en/'));
  return sanPham.map((sp) => ({
    params: { slug: sp.id.split('/').pop()! },
    props: { sp },
  }));
}

const lang = 'en' as const;
const t = useT(lang);
const { sp } = Astro.props;
const { Content } = await render(sp);
const d = sp.data;
const laTBYT = d.phan_loai_phap_ly.startsWith('thiet-bi-y-te');
const slug = sp.id.split('/').pop()!;
const nhanPhanLoai = t(`badge.${d.phan_loai_phap_ly}` as Parameters<typeof t>[0]);
const site = Astro.site ?? new URL(SITE_URL);

const jsonLdProduct = {
  '@context': 'https://schema.org',
  '@type': laTBYT ? 'MedicalDevice' : 'Product',
  name: d.ten,
  brand: { '@type': 'Brand', name: d.thuong_hieu },
  manufacturer: { '@type': 'Organization', name: d.chu_so_huu_ten },
  sku: d.ma_san_pham,
  identifier: d.so_luu_hanh_hoac_cong_bo,
  category: nhanPhanLoai,
  countryOfOrigin: d.xuat_xu,
  description: d.meta_description,
};

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('chung.trang_chu'), item: new URL(localePath(lang, '/'), site).href },
    { '@type': 'ListItem', position: 2, name: t('nav.san_pham'), item: new URL(localePath(lang, '/san-pham'), site).href },
    { '@type': 'ListItem', position: 3, name: d.ten, item: new URL(localePath(lang, `/san-pham/${slug}`), site).href },
  ],
};
---

<Base
  title={d.meta_title ?? `${d.ten} | The Hangi Vietnam`}
  description={d.meta_description}
  lang={lang}
  path={`/san-pham/${slug}`}
  ogImage={d.anh}
  ogImageAlt={d.anh_alt}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLdProduct)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <BannerChuyenMon lang={lang} />

    <nav class="mt-6 font-mono text-xs text-muc/50" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')} class="hover:text-duoc hover:underline">{t('chung.trang_chu')}</a>
      <span aria-hidden="true"> / </span>
      <a href={localePath(lang, '/san-pham')} class="hover:text-duoc hover:underline">{t('nav.san_pham')}</a>
      <span aria-hidden="true"> / </span>
      <span class="text-muc/80">{d.ten}</span>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-4">
        <div class="overflow-hidden rounded-3xl bg-bacha">
          <Image src={d.anh} alt={d.anh_alt} width={880} loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
        </div>
        {
          d.gallery.length > 0 && (
            <div class="grid grid-cols-2 gap-4">
              {d.gallery.map((g) => (
                <div class="overflow-hidden rounded-2xl bg-bacha">
                  <Image src={g.src} alt={g.alt} width={440} class="h-full w-full object-cover" />
                </div>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <p class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-ngoclam">{d.thuong_hieu}</p>
        <h1 class="mt-1.5 text-3xl font-bold tracking-tight text-muc sm:text-4xl">{d.ten}</h1>
        <div class="mt-4">
          <BadgePhapLy phanLoai={d.phan_loai_phap_ly} lang={lang} />
        </div>

        {
          d.hoat_chat.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2" aria-label={t('sp.hoat_chat')}>
              {d.hoat_chat.map((hc) => (
                <li>
                  <ChipHoatChat ten={hc} lang={lang} tinh />
                </li>
              ))}
            </ul>
          )
        }

        <section class="mt-6 overflow-hidden rounded-2xl border border-bacha" aria-labelledby="phap-ly">
          <h2 id="phap-ly" class="bg-bacha px-4 py-2.5 text-sm font-bold text-duoc-dam">
            {t('sp.thong_tin_phap_ly')}
          </h2>
          <dl class="divide-y divide-bacha text-sm">
            {
              [
                laTBYT && d.ten_thiet_bi ? [t('sp.ten_thiet_bi'), d.ten_thiet_bi] : null,
                [t('sp.phan_loai'), nhanPhanLoai],
                [t('sp.ma_sp'), d.ma_san_pham],
                [t('sp.so_cong_bo'), d.so_luu_hanh_hoac_cong_bo],
                d.ngay_cong_bo ? [t('sp.ngay_cong_bo'), d.ngay_cong_bo] : null,
                d.co_so_cong_bo_ten ? [t('sp.co_so_cong_bo'), `${d.co_so_cong_bo_ten} - ${d.co_so_cong_bo_dia_chi}`] : null,
                [t('sp.chu_so_huu'), `${d.chu_so_huu_ten} - ${d.chu_so_huu_dia_chi}`],
                [t('sp.nha_phan_phoi'), `${SITE.ten_day_du_en} - ${SITE.tru_so_en}`],
                [t('sp.xuat_xu'), d.xuat_xu],
              ]
                .filter((r): r is [string, string] => !!r)
                .map(([nhan, giaTri]) => (
                  <div class="grid gap-1 px-4 py-2.5 sm:grid-cols-[200px_1fr] sm:gap-3">
                    <dt class="font-medium text-muc/60">{nhan}</dt>
                    <dd class="text-muc">{giaTri}</dd>
                  </div>
                ))
            }
          </dl>
        </section>

        <section class="mt-6" aria-labelledby="muc-dich">
          <h2 id="muc-dich" class="text-sm font-bold uppercase tracking-wider text-duoc-dam">{t('sp.muc_dich')}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muc/80">{d.muc_dich_su_dung}</p>
        </section>

        {
          d.thanh_phan && (
            <section class="mt-6" aria-labelledby="thanh-phan">
              <h2 id="thanh-phan" class="text-sm font-bold uppercase tracking-wider text-duoc-dam">
                {t('sp.thanh_phan')}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-muc/80">{d.thanh_phan}</p>
            </section>
          )
        }

        <section class="mt-6" aria-labelledby="quy-cach">
          <h2 id="quy-cach" class="text-sm font-bold uppercase tracking-wider text-duoc-dam">{t('sp.quy_cach')}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muc/80">{d.quy_cach}</p>
        </section>

        {
          d.tai_lieu.length > 0 && (
            <section class="mt-6" aria-labelledby="tai-lieu">
              <h2 id="tai-lieu" class="text-sm font-bold uppercase tracking-wider text-duoc-dam">
                {t('sp.tai_lieu')}
              </h2>
              <ul class="mt-2 space-y-2">
                {d.tai_lieu.map((tl) => (
                  <li>
                    <a
                      href={`${BASE}${tl.file}`}
                      class="inline-flex items-center gap-2 rounded-xl border border-bacha px-3.5 py-2.5 text-sm font-medium text-duoc transition-colors hover:border-duoc/40 hover:bg-bacha"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                          d="M12 3v12m0 0 4-4m-4 4-4-4m-4 8h16"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {tl.ten} (PDF)
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          d.canh_bao.length > 0 && (
            <section class="mt-6 rounded-2xl border border-hophach/30 bg-hophach-nhat p-4" aria-labelledby="canh-bao">
              <h2 id="canh-bao" class="text-sm font-bold uppercase tracking-wider text-[#8a5a10]">
                {t('sp.canh_bao')}
              </h2>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-[#6d4a12]">
                {d.canh_bao.map((cb) => (
                  <li>{cb}</li>
                ))}
              </ul>
            </section>
          )
        }

        <a
          href={`${localePath(lang, '/lien-he')}?san-pham=${encodeURIComponent(d.ma_san_pham)}`}
          class="mt-8 inline-flex rounded-full bg-duoc px-7 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-duoc-dam"
        >
          {t('sp.yeu_cau_bao_gia')}
        </a>
      </div>
    </div>

    <ThongTinSanPham sp={sp} lang={lang} />

    <div class="mt-10 max-w-none text-[12.5px] leading-relaxed text-muc/55 [&_p]:mt-2 [&_p:first-child]:mt-0">
      <Content />
    </div>
  </div>
</Base>
